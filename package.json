{
  "name": "drift-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "Black-box BDD acceptance suite for Drift's HTTP API.",
  "license": "MIT",
  "scripts": {
    "test": "NODE_OPTIONS=\"--import tsx\" cucumber-js",
    "test:ci": "NODE_OPTIONS=\"--import tsx\" cucumber-js --format progress --format html:reports/cucumber.html",
    "mutation": "bash scripts/mutation-check.sh",
    "generate": "openapi-typescript ${DRIFT_SPEC:-../drift/openapi.yaml} -o features/support/contract.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:prose": "node scripts/check-punctuation.mjs",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0"
  }
}
