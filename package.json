{
  "name": "drift-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Black-box BDD acceptance suite for Drift's HTTP API.",
  "license": "MIT",
  "scripts": {
    "test": "NODE_OPTIONS=\"--import tsx\" cucumber-js",
    "test:ci": "NODE_OPTIONS=\"--import tsx\" cucumber-js --format progress --format html:reports/cucumber.html",
    "mutation": "bash scripts/mutation-check.sh",
    "generate": "openapi-typescript ${DRIFT_SPEC:-../drift/openapi.yaml} -o features/support/contract.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:prose": "node scripts/check-punctuation.mjs",
    "lint:md": "markdownlint-cli2",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "markdownlint-cli2": "^0.24.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },
    "micromark-extension-math": {
      "katex": "^0.19.1"
    },
    "@redocly/openapi-core": {
      "brace-expansion": "^2.1.8"
    }
  }
}
